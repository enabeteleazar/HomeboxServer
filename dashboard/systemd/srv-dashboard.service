[Unit]
Description=Dashboard /srv — suivi des projets et API pour Neron
Documentation=file:///srv/HomeboxServer/dashboard/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=eleazar
Group=eleazar
WorkingDirectory=/srv/HomeboxServer/dashboard

# Même interpréteur que `make dashboard` : le venv du dépôt (fastapi, uvicorn…).
Environment=SRV_ROOT=/srv
Environment=DASHBOARD_PORT=5199
Environment=PYTHONUNBUFFERED=1
# systemd démarre avec un PATH minimal : on ajoute les emplacements habituels
# de pnpm, npx, vercel et gh sous le HOME d'eleazar. À ajuster si
# `command -v pnpm npx vercel gh` (voir README) en trouve ailleurs.
Environment=PATH=/home/eleazar/.local/bin:/home/eleazar/.local/share/pnpm/bin:/home/eleazar/.local/share/pnpm:/home/eleazar/.npm-global/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/srv/HomeboxServer/dashboard/.venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port ${DASHBOARD_PORT}

Restart=on-failure
RestartSec=3
TimeoutStopSec=20

# IMPORTANT : le dashboard lance les serveurs des projets (npx serve, vite…)
# avec setsid/nohup — ils doivent survivre à un stop/restart du dashboard.
# KillMode=process ne signale que le processus principal, pas tout le cgroup.
KillMode=process

# Durcissement volontairement léger : les actions du dashboard appellent
# git, gh, pnpm, npx et vercel, qui écrivent tous dans le HOME d'eleazar
# (~/.npm, ~/.vercel, ~/.config/gh). Un ProtectHome les casserait.
#
# Pas de NoNewPrivileges : la page Pare-feu passe par
# `sudo -n /usr/local/sbin/homebox-firewall`, seul programme autorisé
# (/etc/sudoers.d/homebox-firewall), qui valide lui-même ses arguments.
# (eleazar est déjà dans le groupe docker, équivalent root : NoNewPrivileges
# n'apportait presque rien.)
# ProtectSystem=full rend /etc en lecture seule pour le service ET ses enfants,
# sudo compris : UFW doit pouvoir écrire ses règles et sa configuration.
ProtectSystem=full
ReadWritePaths=/srv /etc/ufw /etc/default/ufw

# Journal : `journalctl -u srv-dashboard -f`
StandardOutput=journal
StandardError=journal
SyslogIdentifier=srv-dashboard

[Install]
WantedBy=multi-user.target
