#!/bin/bash
# ==========================================================
# HOMEBOX SITE : publier un projet derrière Caddy (HTTPS auto)
#
#   homebox-site add <domaine> <port>        reverse proxy vers 127.0.0.1:<port>
#   homebox-site add <domaine> --static <dossier>   fichiers statiques (build Vite...)
#   homebox-site remove <domaine>
#   homebox-site list
#
# Le domaine doit pointer (DNS A/AAAA) vers cette machine pour que
# Caddy obtienne le certificat HTTPS. Les ports 80 et 443 sont
# ouverts par install-node.sh (OPEN_WEB=true).
# ==========================================================

set -Eeuo pipefail

# shellcheck source=../lib/common.sh
. "${HOMEBOX_LIB:-/usr/local/lib/homebox/common.sh}"

require_root

SITES_DIR="${CADDY_SITES_DIR:-/etc/caddy/sites}"
CADDYFILE="${CADDYFILE:-/etc/caddy/Caddyfile}"

usage() {
    sed -n '/^#   homebox-site/s/^#   //p' "$0"
    exit 1
}

command -v caddy >/dev/null 2>&1 || die "Caddy n'est pas installé."
grep -q "import $SITES_DIR/" "$CADDYFILE" 2>/dev/null \
    || die "$CADDYFILE n'importe pas $SITES_DIR (relance infra-docker.sh)."

check_domain() {
    [[ "$1" =~ ^([a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?\.)+[a-z]{2,63}$ ]] \
        || die "domaine invalide : $1"
}

reload_caddy() {
    caddy validate --config "$CADDYFILE" --adapter caddyfile >/dev/null 2>&1 || return 1
    systemctl reload caddy
}

cmd="${1:-}"
domain="${2:-}"
[ -n "$cmd" ] || usage

case "$cmd" in

    add)
        check_domain "$domain"
        target="${3:-}"
        file="$SITES_DIR/$domain.caddy"
        [ -e "$file" ] && die "le site existe déjà : $file"
        install -d -m 0755 "$SITES_DIR"

        if [ "$target" = "--static" ]; then
            root="${4:-}"
            [ -d "$root" ] || die "dossier introuvable : $root"
            root="$(cd "$root" && pwd)"
            cat > "$file" <<SITE
$domain {
	import homebox_common
	root * $root
	try_files {path} /index.html
	file_server
}
SITE
        else
            [[ "$target" =~ ^[0-9]{2,5}$ ]] || usage
            ss -ltn "sport = :$target" | grep -q LISTEN \
                || echo "Attention : rien n'écoute encore sur le port $target."
            cat > "$file" <<SITE
$domain {
	import homebox_common
	reverse_proxy 127.0.0.1:$target
}
SITE
        fi

        chmod 0644 "$file"

        if ! reload_caddy; then
            rm -f "$file"
            caddy validate --config "$CADDYFILE" --adapter caddyfile || true
            die "configuration refusée par Caddy, site non ajouté."
        fi
        echo "Site ajouté : https://$domain"
        ;;

    remove)
        check_domain "$domain"
        file="$SITES_DIR/$domain.caddy"
        [ -f "$file" ] || die "site inconnu : $domain"
        mv "$file" "$file.removed"
        if ! reload_caddy; then
            mv "$file.removed" "$file"
            die "Caddy refuse la nouvelle configuration, site conservé."
        fi
        rm -f "$file.removed"
        echo "Site retiré : $domain"
        ;;

    list)
        find "$SITES_DIR" -maxdepth 1 -name '*.caddy' -printf '%f\n' 2>/dev/null \
            | sed 's/\.caddy$//' | sort
        ;;

    *)
        usage
        ;;
esac
