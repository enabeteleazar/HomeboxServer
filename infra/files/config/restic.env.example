# ==========================================================
# HOMEBOX : copie externe des sauvegardes avec restic (root, 0600)
# 1. Choisis UNE destination ci-dessous et renseigne RESTIC_REPOSITORY
# 2. sudo homebox-offsite init   (crée le dépôt et son mot de passe)
# 3. sudo systemctl start homebox-backup.service   (premier envoi)
# Les données sont chiffrées avant de quitter la machine.
# ==========================================================

RESTIC_REPOSITORY=""

# --- Disque USB / second disque monté ---
# RESTIC_REPOSITORY="/mnt/usb/homebox-restic"

# --- Autre machine en SFTP (clé SSH de root : sudo ssh-keygen ; ssh-copy-id) ---
# RESTIC_REPOSITORY="sftp:user@nas.local:/volume1/backups/homebox"

# --- Backblaze B2 (environ 6 $/To/mois) ---
# RESTIC_REPOSITORY="b2:nom-du-bucket:homebox"
# B2_ACCOUNT_ID=""
# B2_ACCOUNT_KEY=""

# --- Stockage compatible S3 (Scaleway, OVH, Wasabi, AWS...) ---
# RESTIC_REPOSITORY="s3:https://s3.fr-par.scw.cloud/nom-du-bucket/homebox"
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""

# Mot de passe du dépôt (généré par « homebox-offsite init »)
RESTIC_PASSWORD_FILE=/etc/homebox/restic.pass
