#!/bin/bash
# ==========================================================
# HOMEBOX RESTORE : vérifier, tester et restaurer les sauvegardes
#
#   homebox-restore list
#   homebox-restore verify   [sauvegarde]           contrôle les sommes SHA256
#   homebox-restore test     [sauvegarde] [--notify] restauration à blanc dans des
#                                                    conteneurs jetables (sans risque)
#   homebox-restore postgres [sauvegarde] [base] [--yes]   restaure une base (toutes par défaut)
#   homebox-restore redis    [sauvegarde] [--yes]          remplace les données Redis
#
# [sauvegarde] = "latest" (défaut), un horodatage ou un chemin.
# ==========================================================

set -Eeuo pipefail
umask 077

# shellcheck source=../lib/common.sh
. "${HOMEBOX_LIB:-/usr/local/lib/homebox/common.sh}"

require_root
load_conf

usage() {
    sed -n '/^#   homebox-restore/s/^#   //p' "$0"
    exit 1
}

ASSUME_YES=false
NOTIFY=false
ARGS=()

for arg in "$@"; do
    case "$arg" in
        --yes|-y) ASSUME_YES=true ;;
        --notify) NOTIFY=true ;;
        *) ARGS+=("$arg") ;;
    esac
done

set -- "${ARGS[@]+"${ARGS[@]}"}"

cmd="${1:-}"
[ -n "$cmd" ] || usage
shift

confirm() {
    local expected="$1" message="$2"
    $ASSUME_YES && return 0
    [ -t 0 ] || die "confirmation impossible hors terminal (ajoute --yes)."
    echo "$message"
    read -r -p "Tape « $expected » pour confirmer : " answer
    [ "$answer" = "$expected" ] || die "annulé."
}

# Liste des bases contenues dans une sauvegarde (ancien et nouveau format)
backup_databases() {
    local dir="$1"
    if [ -d "$dir/postgres" ]; then
        find "$dir/postgres" -maxdepth 1 -name '*.dump' -printf '%f\n' | sed 's/\.dump$//' | sort
    elif [ -f "$dir/postgres.dump" ]; then
        get_env POSTGRES_DB
    fi
}

dump_path() {
    local dir="$1" db="$2"
    if [ -f "$dir/postgres/$db.dump" ]; then
        echo "$dir/postgres/$db.dump"
    elif [ -f "$dir/postgres.dump" ] && [ "$db" = "$(get_env POSTGRES_DB)" ]; then
        echo "$dir/postgres.dump"
    else
        die "base « $db » absente de la sauvegarde $dir"
    fi
}

verify_backup() {
    local dir="$1"
    [ -f "$dir/SHA256SUMS" ] || die "SHA256SUMS absent dans $dir"
    (cd "$dir" && sha256sum --quiet -c SHA256SUMS) || die "sauvegarde corrompue : $dir"
    echo "Intégrité OK : $dir"
}

# ----------------------------------------------------------
# list
# ----------------------------------------------------------

cmd_list() {
    local dir
    printf '%-17s %8s  %s\n' "SAUVEGARDE" "TAILLE" "BASES"
    while IFS= read -r dir; do
        printf '%-17s %8s  %s\n' \
            "$(basename "$dir")" \
            "$(du -sh "$dir" | cut -f1)" \
            "$(backup_databases "$dir" | paste -sd ' ')"
    done < <(find "$BACKUP_DIR" -mindepth 1 -maxdepth 1 -type d -name '20*' | sort)
}

# ----------------------------------------------------------
# test : restauration à blanc, sans toucher aux vraies données
# ----------------------------------------------------------

TEST_PG="homebox-restoretest-pg-$$"
TEST_REDIS="homebox-restoretest-redis-$$"
TEST_TMP=""

cleanup_test() {
    docker rm -f "$TEST_PG" "$TEST_REDIS" >/dev/null 2>&1 || true
    [ -n "$TEST_TMP" ] && rm -rf "$TEST_TMP"
}

cmd_test() {
    local dir="$1"
    local pg_image redis_image db dump tables keys report=""

    verify_backup "$dir"

    pg_image="$(docker inspect -f '{{.Config.Image}}' "$PG_CONTAINER" 2>/dev/null || echo "${POSTGRES_IMAGE:-postgres:18}")"
    redis_image="$(docker inspect -f '{{.Config.Image}}' "$REDIS_CONTAINER" 2>/dev/null || echo "${REDIS_IMAGE:-redis:8-alpine}")"

    trap cleanup_test EXIT
    TEST_TMP="$(mktemp -d)"

    # --- PostgreSQL ---
    echo "PostgreSQL : démarrage d'un conteneur de test ($pg_image)..."
    docker run -d --name "$TEST_PG" --network none \
        -e POSTGRES_PASSWORD=restoretest -e POSTGRES_USER=postgres \
        "$pg_image" >/dev/null

    local waited=0
    until docker exec "$TEST_PG" pg_isready -U postgres -q 2>/dev/null &&
          docker exec "$TEST_PG" psql -U postgres -AtXc 'SELECT 1' >/dev/null 2>&1; do
        [ "$waited" -ge 60 ] && die "le PostgreSQL de test ne démarre pas."
        sleep 2; waited=$(( waited + 2 ))
    done

    # Les rôles (erreurs normales pour le rôle "postgres" déjà présent)
    if [ -f "$dir/postgres-globals.sql" ]; then
        docker exec -i "$TEST_PG" psql -U postgres -q -X < "$dir/postgres-globals.sql" >/dev/null 2>&1 || true
    fi

    while IFS= read -r db; do
        [ -n "$db" ] || continue
        dump="$(dump_path "$dir" "$db")"

        if [ "$db" != "postgres" ]; then
            docker exec "$TEST_PG" createdb -U postgres "$db"
        fi

        docker exec -i "$TEST_PG" pg_restore -U postgres -d "$db" \
            --exit-on-error --no-owner --no-acl < "$dump" \
            || die "échec de restauration de la base « $db »"

        tables="$(docker exec "$TEST_PG" psql -U postgres -d "$db" -AtXc \
            "SELECT count(*) FROM pg_tables WHERE schemaname NOT IN ('pg_catalog','information_schema')")"
        echo "  base $db : restaurée, $tables table(s)"
        report+="$db: $tables table(s). "
    done < <(backup_databases "$dir")

    # --- Redis ---
    echo "Redis : chargement du snapshot dans un conteneur de test ($redis_image)..."
    install -d -m 0777 "$TEST_TMP/redis"
    install -m 0644 "$dir/redis.rdb" "$TEST_TMP/redis/dump.rdb"

    docker run -d --name "$TEST_REDIS" --network none \
        -v "$TEST_TMP/redis:/data" \
        "$redis_image" redis-server --appendonly no --save '' >/dev/null

    waited=0
    until [ "$(docker exec "$TEST_REDIS" redis-cli ping 2>/dev/null)" = "PONG" ]; do
        [ "$waited" -ge 30 ] && die "le Redis de test ne démarre pas (RDB illisible ?)."
        sleep 1; waited=$(( waited + 1 ))
    done

    keys="$(docker exec "$TEST_REDIS" redis-cli dbsize)"
    echo "  Redis : snapshot chargé, $keys clé(s)"
    report+="Redis: $keys clé(s)."

    echo ""
    echo "Test de restauration réussi : $(basename "$dir")"

    if $NOTIFY; then
        notify "Test de restauration OK" "Sauvegarde $(basename "$dir") : $report" 2 "white_check_mark"
    fi
}

# ----------------------------------------------------------
# postgres : restauration réelle
# ----------------------------------------------------------

cmd_postgres() {
    local dir="$1" only_db="${2:-}"
    local pg_user dbs db dump exists safety

    container_running "$PG_CONTAINER" || die "conteneur non démarré : $PG_CONTAINER"
    verify_backup "$dir"
    pg_user="$(get_env POSTGRES_USER)"

    if [ -n "$only_db" ]; then
        dump_path "$dir" "$only_db" >/dev/null
        dbs="$only_db"
    else
        dbs="$(backup_databases "$dir" | grep -vx postgres || true)"
    fi
    [ -n "$dbs" ] || die "aucune base à restaurer."

    confirm "restaurer" "Le contenu actuel de : $(echo "$dbs" | paste -sd ' ') sera REMPLACÉ par la sauvegarde $(basename "$dir")."

    # Les rôles d'abord (projets), sans écraser celui de l'administrateur
    if [ -f "$dir/postgres-globals.sql" ]; then
        grep -vE "^(CREATE|ALTER) ROLE \"?${pg_user}\"?[ ;]" "$dir/postgres-globals.sql" \
            | docker exec -i "$PG_CONTAINER" psql -U "$pg_user" -d postgres -q -X >/dev/null 2>&1 || true
    fi

    while IFS= read -r db; do
        [ -n "$db" ] || continue
        dump="$(dump_path "$dir" "$db")"

        exists="$(docker exec "$PG_CONTAINER" psql -U "$pg_user" -d postgres -AtXc \
            "SELECT 1 FROM pg_database WHERE datname = '$db'")"

        if [ "$exists" = "1" ]; then
            # Copie de sécurité de l'état actuel avant d'écraser
            safety="$BACKUP_DIR/pre-restore-$(date '+%Y%m%d-%H%M%S')-$db.dump"
            docker exec "$PG_CONTAINER" pg_dump -U "$pg_user" -d "$db" -Fc > "$safety"
            echo "État actuel de « $db » sauvegardé : $safety"

            docker exec -i "$PG_CONTAINER" pg_restore -U "$pg_user" -d "$db" \
                --clean --if-exists --single-transaction < "$dump"
        else
            docker exec -i "$PG_CONTAINER" pg_restore -U "$pg_user" -d postgres \
                --create --exit-on-error < "$dump"
        fi

        echo "Base « $db » restaurée."
    done <<< "$dbs"
}

# ----------------------------------------------------------
# redis : restauration réelle
# ----------------------------------------------------------

cmd_redis() {
    local dir="$1"
    local image volume stamp tmp keys waited

    verify_backup "$dir"
    [ -f "$ENV_FILE" ] || die "fichier .env introuvable : $ENV_FILE"

    image="$(docker inspect -f '{{.Config.Image}}' "$REDIS_CONTAINER")"
    volume="$(docker inspect -f '{{range .Mounts}}{{if eq .Destination "/data"}}{{.Name}}{{end}}{{end}}' "$REDIS_CONTAINER")"
    [ -n "$volume" ] || die "volume Redis introuvable."

    confirm "restaurer" "Les données Redis actuelles seront REMPLACÉES par la sauvegarde $(basename "$dir") (l'ancien contenu est gardé dans le volume, dossier pre-restore-*)."

    stamp="$(date '+%Y%m%d-%H%M%S')"
    tmp="$(mktemp -d)"
    install -m 0644 "$dir/redis.rdb" "$tmp/redis.rdb"

    echo "Arrêt de Redis..."
    docker stop "$REDIS_CONTAINER" >/dev/null

    # Ancien contenu mis de côté, snapshot installé en dump.rdb, AOF supprimé :
    # sinon Redis rechargerait l'AOF en priorité et ignorerait le snapshot.
    docker run --rm --network none -v "$volume:/data" -v "$tmp:/restore:ro" "$image" sh -c "
        set -e
        mkdir -p /data/pre-restore-$stamp
        for f in /data/* ; do
            case \"\$f\" in /data/pre-restore-*) ;; *) [ -e \"\$f\" ] && mv \"\$f\" /data/pre-restore-$stamp/ ;; esac
        done
        cp /restore/redis.rdb /data/dump.rdb
        chown -R redis:redis /data
    "

    # Premier démarrage sans AOF pour charger le RDB, puis réactivation :
    # Redis régénère alors l'AOF à partir des données chargées.
    echo "Chargement du snapshot..."
    docker run -d --name homebox-redis-restore --network none -v "$volume:/data" "$image" \
        redis-server --appendonly no >/dev/null

    waited=0
    until [ "$(docker exec homebox-redis-restore redis-cli ping 2>/dev/null)" = "PONG" ]; do
        if [ "$waited" -ge 60 ]; then
            docker rm -f homebox-redis-restore >/dev/null 2>&1 || true
            rm -rf "$tmp"
            die "Redis ne démarre pas avec ce snapshot. Ancien contenu : volume $volume, dossier pre-restore-$stamp"
        fi
        sleep 1; waited=$(( waited + 1 ))
    done

    keys="$(docker exec homebox-redis-restore redis-cli dbsize)"
    docker exec homebox-redis-restore redis-cli config set appendonly yes >/dev/null

    waited=0
    until docker exec homebox-redis-restore redis-cli info persistence \
            | tr -d '\r' | grep -q '^aof_rewrite_in_progress:0' &&
          docker exec homebox-redis-restore redis-cli info persistence \
            | tr -d '\r' | grep -q '^aof_rewrite_scheduled:0' &&
          docker exec homebox-redis-restore redis-cli info persistence \
            | tr -d '\r' | grep -q '^aof_enabled:1'; do
        [ "$waited" -ge 120 ] && die "réécriture de l'AOF trop longue."
        sleep 1; waited=$(( waited + 1 ))
    done

    docker exec homebox-redis-restore redis-cli shutdown >/dev/null 2>&1 || true
    docker wait homebox-redis-restore >/dev/null 2>&1 || true
    docker rm -f homebox-redis-restore >/dev/null 2>&1 || true
    rm -rf "$tmp"

    echo "Redémarrage de Redis..."
    docker start "$REDIS_CONTAINER" >/dev/null
    wait_healthy "$REDIS_CONTAINER" 60 || die "Redis ne redevient pas healthy."

    local now
    now="$(docker exec "$REDIS_CONTAINER" sh -c 'REDISCLI_AUTH="$REDIS_PASSWORD" redis-cli dbsize')"
    [ "$now" = "$keys" ] || die "nombre de clés inattendu après redémarrage : $now (attendu $keys)"

    echo "Redis restauré : $keys clé(s). Ancien contenu gardé dans le volume $volume (pre-restore-$stamp)."
}

# ----------------------------------------------------------

case "$cmd" in
    list)     cmd_list ;;
    verify)   verify_backup "$(resolve_backup "${1:-latest}")" ;;
    test)     cmd_test "$(resolve_backup "${1:-latest}")" ;;
    postgres) cmd_postgres "$(resolve_backup "${1:-latest}")" "${2:-}" ;;
    redis)    cmd_redis "$(resolve_backup "${1:-latest}")" ;;
    *)        usage ;;
esac
